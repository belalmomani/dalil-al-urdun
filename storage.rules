rules_version = '2';

// قواعد Firebase Storage — «دليل الأردن».
// القراءة العامة للصور/الفيديو لأن التطبيق يعرضها للزوار؛ الكتابة والحذف للطاقم المصرّح (claims من الخادم) فقط.
// ملاحظة: المسودات لا تظهر للزوار لأن قوائم الوسائط في Firestore محمية بحالة النشر؛
// أما ملف Storage نفسه فيمكن قراءته لمن يعرف مساره الكامل. للتشديد انظر README (قسم «قراءة Storage المشروطة»).

service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin()  { return verified() && request.auth.token.admin == true; }
    function isStaff()  { return isAdmin() || (verified() && request.auth.token.editor == true); }

    function okImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function okVideo() {
      return request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)');
    }

    match /places/{placeId}/images/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && okImage() && fileName.matches('[A-Za-z0-9._-]{1,120}');
      allow delete: if isStaff();
    }
    match /places/{placeId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && okVideo() && fileName.matches('[A-Za-z0-9._-]{1,120}');
      allow delete: if isStaff();
    }
    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && okImage();
      allow delete: if isAdmin();
    }
    match /app-assets/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && okImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
